{
  "name": "snack-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "tsx src/register.ts",
    "migrate:local": "wrangler d1 migrations apply snack-bot --local",
    "migrate": "wrangler d1 migrations apply snack-bot --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:local": "tsx scripts/seed.ts --local"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.130.0"
  }
}
